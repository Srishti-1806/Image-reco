# ---- core server ----
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=change-me
# 32 random bytes, base64:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PAYLOAD_KEY_B64=
# cosine similarity. ArcFace/buffalo_l genuine pairs are usually ~0.4-0.7. TUNE THIS on your own data.
MATCH_THRESHOLD=0.45
# CN of each device client cert : zone   (zone = secure | public)
ALLOWED_DEVICES=jetson-01:secure,jetson-02:public
ALERT_WEBHOOK_URL=
AUDIT_DB_PATH=/data/audit.sqlite3
RATE_LIMIT_PER_SEC=10

# ---- edge device ----
CAMERA_URL=rtsp://user:pass@192.168.1.10/stream1
CORE_URL=https://core.local:8443
TLS_CA=network_security/certs/ca.crt
TLS_CERT=network_security/certs/jetson-01.crt
TLS_KEY=network_security/certs/jetson-01.key
